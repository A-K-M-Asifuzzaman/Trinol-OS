# Trinol OS — environment variables
# Copy to .env and fill in real values. Never commit .env.
# See docs/architecture/DEPLOYMENT.md and docs/architecture/AUTH.md.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://trinol:trinol@localhost:5432/trinol_os

# --- API ---
API_PORT=8000
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=trinol_session

# --- Firebase (server) ---
# Service-account JSON for token verification (ADR-0013). Path to the file,
# or base64-encoded contents. NEVER commit the real value.
FIREBASE_CREDENTIALS=

# --- Firebase (web, public by design — see AUTH.md §10) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Storage (ADR-0008) ---
STORAGE_BACKEND=local
# S3-compatible (staging/production):
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- Email (EMAIL.md) ---
EMAIL_BACKEND=console
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=hello@trinolit.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hello@trinolit.com
SMTP_FROM_NAME=TrinolIT

# --- Public contact endpoint (SECURITY.md §5) ---
PUBLIC_CONTACT_ORG_SLUG=
