# Trinol OS — environment variables
# Copy to .env and fill in real values. Never commit .env.
# See docs/architecture/DEPLOYMENT.md and docs/architecture/AUTH.md.

# --- Database ---
# Two roles, always — never just one, in every environment including local/CI.
# trinol_app cannot UPDATE/DELETE activity_events (ADR-0006); that grant is
# meaningless if the app connects as the table owner, so migrations run as a
# separate role. See docs/architecture/DATABASE.md.
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://trinol_app:trinol_app@localhost:5432/trinol_os
DATABASE_MIGRATION_URL=postgresql+asyncpg://trinol_migrator:trinol_migrator@localhost:5432/trinol_os

# --- API ---
API_PORT=8000
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=trinol_session

# --- Firebase (server) ---
# Service-account JSON for token verification (ADR-0013). Path to the file,
# or base64-encoded contents. NEVER commit the real value.
FIREBASE_CREDENTIALS=

# --- E2E test mode (Phase 2 Stage 11, Playwright only) ---
# Swaps the real Firebase verifier for E2EIdentityVerifier (identity/
# e2e_verifier.py), so `pnpm exec playwright test` can log in against a real
# running server with no Firebase project of its own — never honored when
# APP_ENV=production, regardless of this flag (deps.py double-checks).
# Leave both unset/false for local dev and production.
E2E_TEST_MODE=false
NEXT_PUBLIC_E2E_TEST_MODE=false

# --- Firebase (web, public by design — see AUTH.md §10) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Web (server-only; never NEXT_PUBLIC_ — see ARCHITECTURE.md §1) ---
# Where the Next.js server itself reaches FastAPI: next.config.mjs's /api/*
# rewrite target for browser requests, and the base URL server components
# use directly. The browser never sees this — it only ever calls relative
# /api/* paths, same-origin. docker-compose.yml overrides this to
# http://api:8000 (the api container's hostname on the Docker network).
INTERNAL_API_URL=http://localhost:8000

# --- Storage (ADR-0008) ---
STORAGE_BACKEND=local
# Local backend only; a directory outside the repo, gitignored at any depth.
LOCAL_STORAGE_DIR=storage/uploads
# S3-compatible (staging/production):
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- Email (EMAIL.md) ---
EMAIL_BACKEND=console
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=hello@trinolit.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hello@trinolit.com
SMTP_FROM_NAME=TrinolIT

# --- Public contact endpoint (SECURITY.md §5) ---
PUBLIC_CONTACT_ORG_SLUG=
# The one origin OriginCheckMiddleware allows besides APP_ORIGIN, and only
# for POST /api/public/contact. Harmless to set now — that route doesn't
# exist until Phase 3, so this does nothing until then.
PUBLIC_CONTACT_ORIGIN=https://www.trinolit.com
